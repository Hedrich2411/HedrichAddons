<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_public_holiday_list" model="ir.ui.view">
        <field name="name">hr.public.holiday.list</field>
        <field name="model">hr.public.holiday</field>
        <field name="arch" type="xml">
            <list string="Public Holidays" editable="bottom" sample="1"
                  multi_edit="1">
                <field name="date"/>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"
                       optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_public_holiday_form" model="ir.ui.view">
        <field name="name">hr.public.holiday.form</field>
        <field name="model">hr.public.holiday</field>
        <field name="arch" type="xml">
            <form string="Public Holiday">
                <sheet>
                    <widget name="web_ribbon" title="Archived"
                            bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"
                                   placeholder="e.g. Independence Day"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_public_holiday_search" model="ir.ui.view">
        <field name="name">hr.public.holiday.search</field>
        <field name="model">hr.public.holiday</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="archived" string="Archived"
                        domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="filter_date" date="date" string="Date"/>
                <group>
                    <filter name="group_date" string="Date"
                            context="{'group_by': 'date'}"/>
                    <filter name="group_company" string="Company"
                            context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_public_holiday" model="ir.actions.act_window">
        <field name="name">Public Holidays</field>
        <field name="res_model">hr.public.holiday</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_public_holiday_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a public holiday</p>
            <p>The attendance engine classifies these dates as
            <i>Holiday</i>. Hours punched on a holiday are reported apart,
            since payroll surcharges them. Leave the company empty to apply
            the holiday to every company.</p>
        </field>
    </record>

</odoo>
