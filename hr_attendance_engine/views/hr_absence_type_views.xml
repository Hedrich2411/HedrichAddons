<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_absence_type_list" model="ir.ui.view">
        <field name="name">hr.absence.type.list</field>
        <field name="model">hr.absence.type</field>
        <field name="arch" type="xml">
            <list string="Absence Types">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
                <field name="default_unit"/>
                <field name="is_paid"/>
                <field name="consumes_vacation_period"/>
                <field name="requires_document" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_hr_absence_type_form" model="ir.ui.view">
        <field name="name">hr.absence.type.form</field>
        <field name="model">hr.absence.type</field>
        <field name="arch" type="xml">
            <form string="Absence Type">
                <sheet>
                    <widget name="web_ribbon" title="Archived"
                            bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Vacation"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="category"/>
                            <field name="default_unit"/>
                            <field name="color" widget="color_picker"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="is_paid"/>
                            <field name="consumes_vacation_period"/>
                            <field name="consumes_compensatory_balance"/>
                            <field name="requires_document"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_absence_type" model="ir.actions.act_window">
        <field name="name">Absence Types</field>
        <field name="res_model">hr.absence.type</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
