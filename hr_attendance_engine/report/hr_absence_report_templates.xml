<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_absence_document">
        <t t-call="web.html_container">
            <t t-call="web.internal_layout">
                <div class="page">
                    <t t-call="hr_attendance_engine.report_styles"/>

                    <div class="o_att_head">
                        <div style="font-size:13px; font-weight:bold;"
                             t-out="company.name"/>
                        <div class="text-center">
                            <div t-att-style="'font-size:16px; font-weight:bold; color:%s;' % brand">
                                ABSENCE REPORT
                            </div>
                            <div style="font-size:11px; font-weight:bold;">
                                FROM: <span t-out="date_from" t-options="{'widget': 'date'}"/>
                                TO: <span t-out="date_to" t-options="{'widget': 'date'}"/>
                            </div>
                        </div>
                        <div class="text-end" style="font-size:10px; font-weight:bold;">
                            PRINTED:
                            <span t-out="printed_on" t-options="{'widget': 'datetime'}"/>
                        </div>
                    </div>

                    <t t-foreach="blocks" t-as="block">
                        <div t-att-style="'font-size:12px; font-weight:bold; margin-top:14px; color:%s;' % brand"
                             t-out="block['employee'].name"/>

                        <table class="o_att_table">
                            <thead>
                                <tr t-att-style="'color:%s;' % brand">
                                    <th>From</th>
                                    <th>To</th>
                                    <th>Code</th>
                                    <th>Type</th>
                                    <th>Category</th>
                                    <th>Unit</th>
                                    <th>Hours</th>
                                    <th>Days</th>
                                    <th>Paid</th>
                                    <th>Status</th>
                                    <th>Reason</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="block['absences']" t-as="absence"
                                    t-att-style="'color:#999;' if absence.state in ('rejected', 'cancelled') else ''">
                                    <td t-out="absence.date_from" t-options="{'widget': 'date'}"/>
                                    <td t-out="absence.date_to" t-options="{'widget': 'date'}"/>
                                    <td>
                                        <strong t-att-style="'color:%s;' % brand"
                                                t-out="absence.type_id.code"/>
                                    </td>
                                    <td t-out="absence.type_id.name"/>
                                    <td t-out="absence.category"/>
                                    <td t-out="absence.unit"/>
                                    <td t-out="absence.duration_hours"/>
                                    <td t-out="absence.duration_days"/>
                                    <td>
                                        <span t-if="absence.type_id.is_paid">Yes</span>
                                        <span t-else="">No</span>
                                    </td>
                                    <td t-out="absence.state"/>
                                    <td style="white-space:normal; text-align:left;"
                                        t-out="absence.reason"/>
                                </tr>
                                <tr t-if="not block['absences']">
                                    <td colspan="11">No absence in this range.</td>
                                </tr>
                            </tbody>
                        </table>

                        <t t-if="block['recap']">
                            <div style="font-size:10px; font-weight:bold; margin-top:12px;">
                                Approved absences by type
                            </div>
                            <table class="o_att_table">
                                <thead>
                                    <tr t-att-style="'color:%s;' % brand">
                                        <th>Code</th>
                                        <th>Type</th>
                                        <th>Requests</th>
                                        <th>Hours</th>
                                        <th>Days</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="block['recap']" t-as="line">
                                        <td>
                                            <strong t-att-style="'color:%s;' % brand"
                                                    t-out="line['type'].code"/>
                                        </td>
                                        <td t-out="line['type'].name"/>
                                        <td t-out="line['count']"/>
                                        <td t-out="line['hours']"/>
                                        <td t-out="line['days']"/>
                                    </tr>
                                </tbody>
                                <tfoot>
                                    <tr class="o_att_total" t-att-style="'color:%s;' % brand">
                                        <td colspan="2">TOTAL</td>
                                        <td t-out="block['totals']['count']"/>
                                        <td t-out="block['totals']['hours']"/>
                                        <td t-out="block['totals']['days']"/>
                                    </tr>
                                </tfoot>
                            </table>
                        </t>
                    </t>
                </div>
            </t>
        </t>
    </template>

</odoo>
