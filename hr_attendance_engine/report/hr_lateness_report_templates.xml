<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_lateness_document">
        <t t-call="web.html_container">
            <t t-call="web.internal_layout">
                <div class="page">
                    <t t-call="hr_attendance_engine.report_styles"/>

                    <div class="o_att_head">
                        <div style="font-size:13px; font-weight:bold;"
                             t-out="company.name"/>
                        <div class="text-center">
                            <div t-att-style="'font-size:16px; font-weight:bold; color:%s;' % brand">
                                LATENESS REPORT
                            </div>
                            <div style="font-size:11px; font-weight:bold;">
                                FROM: <span t-out="date_from" t-options="{'widget': 'date'}"/>
                                TO: <span t-out="date_to" t-options="{'widget': 'date'}"/>
                            </div>
                        </div>
                        <div class="text-end" style="font-size:10px; font-weight:bold;">
                            PRINTED:
                            <span t-out="printed_on" t-options="{'widget': 'datetime'}"/>
                        </div>
                    </div>

                    <p t-if="not blocks">
                        No lateness recorded in this period.
                    </p>

                    <t t-foreach="blocks" t-as="block">
                        <div t-att-style="'font-size:12px; font-weight:bold; margin-top:12px; color:%s;' % brand"
                             t-out="block['employee'].name"/>
                        <table class="o_att_table">
                            <thead>
                                <tr t-att-style="'color:%s;' % brand">
                                    <th>Date</th>
                                    <th>Day</th>
                                    <th>Schedule</th>
                                    <th>Check-in</th>
                                    <th>Check-out</th>
                                    <th>Late<br/>In</th>
                                    <th>Late<br/>Break</th>
                                    <th>Late<br/>Total</th>
                                    <th>Early<br/>Leave</th>
                                    <th>Hrs. to<br/>Deduct</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="block['rows']" t-as="row">
                                    <td t-out="row['date']" t-options="{'widget': 'date'}"/>
                                    <td t-out="row['day_name']"/>
                                    <td class="o_att_sched" t-out="row['schedule']"/>
                                    <td t-out="row['entries']"/>
                                    <td t-out="row['exits']"/>
                                    <td t-out="row['late']"/>
                                    <td t-out="row['late_break']"/>
                                    <td t-out="row['late_total']"/>
                                    <td t-out="row['early']"/>
                                    <td t-out="row['discount']"/>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr class="o_att_total" t-att-style="'color:%s;' % brand">
                                    <td/>
                                    <td>TOTAL</td>
                                    <td/><td/><td/>
                                    <td t-out="block['totals']['late']"/>
                                    <td t-out="block['totals']['late_break']"/>
                                    <td t-out="block['totals']['late_total']"/>
                                    <td t-out="block['totals']['early']"/>
                                    <td t-out="block['totals']['discount']"/>
                                </tr>
                            </tfoot>
                        </table>
                    </t>
                </div>
            </t>
        </t>
    </template>

</odoo>
