<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_schedule_assignment_wizard_form" model="ir.ui.view">
        <field name="name">hr.schedule.assignment.wizard.form</field>
        <field name="model">hr.schedule.assignment.wizard</field>
        <field name="arch" type="xml">
            <form string="Bulk Schedule Assignment">
                <sheet>
                    <group>
                        <group>
                            <field name="schedule_id"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group>
                            <field name="overwrite_existing"/>
                        </group>
                    </group>
                    <field name="employee_ids" widget="many2many_tags"
                           options="{'no_create': True}"/>
                </sheet>
                <footer>
                    <button name="action_assign" type="object"
                            string="Assign" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hr_schedule_assignment_wizard" model="ir.actions.act_window">
        <field name="name">Bulk Assign Schedules</field>
        <field name="res_model">hr.schedule.assignment.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
