<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_attendance_report_wizard_form" model="ir.ui.view">
        <field name="name">hr.attendance.report.wizard.form</field>
        <field name="model">hr.attendance.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Attendance Report">
                <group>
                    <!-- Launched from the Print menu of an employee: the
                         scope is already decided, so it stays hidden. -->
                    <group>
                        <field name="report_type" widget="radio"/>
                        <field name="scope" widget="radio"
                               invisible="context.get('active_model') == 'hr.employee'"/>
                    </group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="department_ids" widget="many2many_tags"
                               options="{'no_create': True}"
                               placeholder="Sub-departments included automatically"
                               invisible="scope != 'department'
                                          or context.get('active_model') == 'hr.employee'"
                               required="scope == 'department'"/>
                        <field name="employee_ids" widget="many2many_tags"
                               options="{'no_create': True}"
                               invisible="scope != 'employee'
                                          or context.get('active_model') == 'hr.employee'"
                               required="scope == 'employee'"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print" type="object"
                            string="Print" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hr_attendance_report_wizard" model="ir.actions.act_window">
        <field name="name">Attendance Reports</field>
        <field name="res_model">hr.attendance.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <!-- Shows up under the Print menu of hr.employee (form and list). -->
        <field name="binding_model_id" ref="hr.model_hr_employee"/>
        <field name="binding_type">report</field>
        <field name="binding_view_types">list,form</field>
        <field name="group_ids"
               eval="[(4, ref('hr_attendance.group_hr_attendance_officer'))]"/>
    </record>

    <menuitem id="menu_hr_attendance_report"
              name="Attendance Reports"
              parent="hr_attendance.menu_hr_attendance_reporting"
              action="action_hr_attendance_report_wizard"
              sequence="50"/>

</odoo>
