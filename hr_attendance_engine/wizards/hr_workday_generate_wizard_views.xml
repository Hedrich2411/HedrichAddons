<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_workday_generate_wizard_form" model="ir.ui.view">
        <field name="name">hr.workday.generate.wizard.form</field>
        <field name="model">hr.workday.generate.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Workdays">
                <sheet>
                    <group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group>
                            <field name="only_assigned"/>
                        </group>
                    </group>
                    <field name="employee_ids" widget="many2many_tags"
                           options="{'no_create': True}"/>
                </sheet>
                <footer>
                    <button name="action_generate" type="object"
                            string="Generate" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hr_workday_generate_wizard" model="ir.actions.act_window">
        <field name="name">Generate Workdays</field>
        <field name="res_model">hr.workday.generate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
